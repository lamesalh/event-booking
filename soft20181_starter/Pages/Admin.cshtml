@page
@model soft20181_starter.Pages.AdminModel
@{
    ViewData["Title"] = "Admin";
}

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="main">
        <div class="container">
            <h1>Admin Panel</h1>
            <p>Manage events and oversee the platform</p>
        </div>
    </div>

    <div class="search-section">
        <div class="container">
            <div class="admin-content">
                <!-- Add New Event Section -->
                <div class="admin-section">
                    <h2>Add New Event</h2>
                    <form method="post" class="admin-form">
                        <div class="form-group">
                            <label for="name">Event Name:</label>
                            <input type="text" id="name" asp-for="NewEvent.Name" required />
                        </div>
                        <div class="form-group">
                            <label for="location">Location:</label>
                            <input type="text" id="location" asp-for="NewEvent.Location" required />
                        </div>
                        <div class="form-group">
                            <label for="eventDateTime">Date and Time:</label>
                            <input type="datetime-local" id="eventDateTime" asp-for="NewEvent.EventDateTime" required />
                        </div>
                        <div class="form-group">
                            <label for="description">Description:</label>
                            <textarea id="description" asp-for="NewEvent.Description" rows="4" required></textarea>
                        </div>
                        <div class="form-group">
                            <label for="coverPhoto">Cover Photo URL:</label>
                            <input type="url" id="coverPhoto" asp-for="NewEvent.CoverPhoto" required />
                        </div>
                        <button type="submit" class="btn-book">Add Event</button>
                    </form>
                </div>

                <!-- Current Events Section -->
                <div class="admin-section">
                    <h2>Current Events</h2>
                    <div class="events-grid">
                        @foreach (var ev in Model.Events)
                        {
                            <div class="event-card admin-card">
                                <div class="event-info">
                                    <h3>@ev.Name</h3>
                                    <p><strong>@ev.Location</strong></p>
                                    <p class="date">@ev.EventDateTime.ToString("dd MMM yyyy")</p>
                                    <p>@ev.Description</p>
                                </div>
                                <div class="card-buttons">
                                    <a asp-page="/Admin" asp-page-handler="Delete" asp-route-id="@ev.Id" 
                                       class="btn-remove" onclick="return confirm('Are you sure you want to delete this event?')">
                                        Delete Event
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- User Management Section -->
                <div class="admin-section">
                    <h2>Registered Users</h2>
                    <div class="users-grid">
                        @foreach (var user in Model.Users)
                        {
                            <div class="user-card admin-card">
                                <div class="user-info">
                                    <h3>@user.Name</h3>
                                    <p><strong>Email:</strong> @user.Email</p>
                                    <p class="date">Registered: @user.CreatedAt.ToString("dd MMM yyyy")</p>
                                </div>
                                <div class="card-buttons">
                                    <a asp-page="/Admin" asp-page-handler="DeleteUser" asp-route-id="@user.Id" 
                                       class="btn-remove" onclick="return confirm('Are you sure you want to delete this user?')">
                                        Delete User
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="main">
        <div class="container">
            <h1>Access Denied</h1>
            <p>You must be logged in to access the admin panel.</p>
            <a asp-page="/Login" class="btn-login">Sign In</a>
        </div>
    </div>
} 