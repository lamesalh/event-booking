@page
@model soft20181_starter.Pages.ContactModel
@{
    ViewData["Title"] = "Contact";
}
<div class="contact-container">
  <div class="left-col">
    <img class="logo" src="https://www.indonesia.travel/content/dam/indtravelrevamp/en/logo.png"/>
            </div>
  <div class="right-col">
    <div class="theme-switch-wrapper">
      <label class="theme-switch" for="checkbox">
          <input type="checkbox" id="checkbox" />
          <div class="slider round"></div>
      </label>
      <div class="description">Dark Mode</div>
            </div>

    <h1>Contact us</h1>
    <form id="contact-form" method="post">
      <label for="name">Full name</label>
      <input asp-for="ContactInfo.Name" type="text" id="name" name="name" placeholder="Your Full Name" required>
      <span asp-validation-for="ContactInfo.Name"></span>
      <label for="email">Email Address</label>
      <input asp-for="ContactInfo.Email" type="email" id="email" name="email" placeholder="Your Email Address" required>
      <span asp-validation-for="ContactInfo.Email"></span>
      <label for="message">Message</label>
      <textarea asp-for="ContactInfo.Message" rows="6" placeholder="Your Message" id="message" name="message" required></textarea>
      <span asp-validation-for="ContactInfo.Message"></span>
      <button type="submit" id="submit" name="submit">Send</button>
    </form>
    
    <div id="popup-message" class="popup hidden">
      <div class="popup-content">
        <p>Thank you for contacting us! We'll get back to you soon.</p>
        <button id="close-popup">Close</button>
            </div>
    </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}



